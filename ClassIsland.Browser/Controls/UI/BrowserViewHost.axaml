<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClassIsland.Browser.Controls.UI.BrowserViewHost">
    <UserControl.Styles>
        <Style Selector="NavigationPage#NavigationPage /template/ Border#PART_NavigationBar">
            <Setter Property="Background" Value="{x:Null}"/>
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <!--
            课表条常驻在页面顶部，对应桌面端贴屏幕边缘的主界面。
            内容延迟到 AppStarted 后由 AttachScheduleBar() 填入——ScheduleBarHost 的构造
            需要 DI 容器，而本宿主在 App.Init() 之前就已创建。
        -->
        <ContentControl x:Name="ScheduleBarContainer"
                        DockPanel.Dock="Top"
                        HorizontalAlignment="Center" />
        <Grid>
            <Grid x:Name="PageContentRoot">
                <Grid.RenderTransform>
                    <TranslateTransform />
                </Grid.RenderTransform>
                <NavigationPage x:Name="NavigationPage"
                                Popped="NavigationPage_OnPopped">
                </NavigationPage>
            </Grid>
            <!--
                宿主级返回按钮。桌面端这些页面是独立窗口、有标题栏可关闭，
                部分视图（如 SettingsWindowNew）因此显式设了 HasBackButton="False"；
                浏览器端它们是压栈的视图，没有窗口标题栏，缺了返回入口就回不到主页。
                放在宿主上而不是逐个改视图，避免影响桌面端。
            -->
            <Button x:Name="HostBackButton"
                    Click="HostBackButton_OnClick"
                    IsVisible="False"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="8"
                    Padding="8 6"
                    CornerRadius="6"
                    ToolTip.Tip="返回"
                    Background="{DynamicResource AcrylicBackgroundFillColorDefaultBrush}"
                    Content="{ci:FluentIcon &#xE0B0;, FontSize=18}" />
            <Border Height="3"
                    VerticalAlignment="Top"
                    ClipToBounds="True"
                    IsHitTestVisible="False">
                <Rectangle x:Name="NavigationProgressBarFill"
                           HorizontalAlignment="Stretch"
                           Fill="{DynamicResource AccentFillColorDefaultBrush}"
                           Opacity="0" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
