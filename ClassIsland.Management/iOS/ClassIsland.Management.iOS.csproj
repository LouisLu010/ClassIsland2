    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">ios-arm64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <ApplicationId>cn.classisland.management</ApplicationId>
    <ApplicationTitle>ClassIsland 集控</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Client/ClassIsland.Management.Client.csproj" />
    <PackageReference Include="Avalonia.iOS" Version="$(AvaloniaVersion)" />
    <BundleResource Include="PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>
</Project>
